# Copy to .env and fill in the required values. Never commit .env.
#
# Minimal deploy (same idea as immich-sftp): credentials + Immich host + TZ.

# GitHub user/org that owns the published images on ghcr.io.
GHCR_OWNER=
# Pin to a release tag (e.g. 1.0.0) for immutable deploys; avoid latest in prod.
IMAGE_TAG=latest

# FTP login for the camera: username:password
# Username: 3-64 chars, not a common name (sony/admin/ftp/...).
# Password: 16-64 random characters.
# Prefer Docker secrets (see docker-compose.secrets.yml) over raw env in production.
FTP_USERS=

# LAN IPv4 of the Docker host (passive FTPS / PASV reply to the camera).
FTP_MASQUERADE_ADDRESS=192.168.1.10

# Immich base URL as seen from the importer container.
# On the Immich Docker network this is typically:
#   http://immich-server:2283
# /api is appended automatically.
IMMICH_HOST=http://immich-server:2283
IMMICH_API_KEY=
# Set to true only when Immich is reachable over plain HTTP on a trusted network.
IMMICH_ALLOW_HTTP=false

# Docker network created by the Immich Compose project (default project name: immich).
IMMICH_DOCKER_NETWORK=immich_default

TZ=Europe/Minsk
