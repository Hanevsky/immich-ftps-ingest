# Copy to .env and fill in the required values. Never commit .env.
#
# Minimal deploy: only credentials + your LAN IP + Immich API key.

# Camera FTP login: username:password
# Username: 3-64 chars, not a common name (sony/admin/ftp/...).
# Password: 16-64 random characters.
FTP_USERS=

# LAN IPv4 of this Docker host (camera connects here).
FTP_MASQUERADE_ADDRESS=192.168.1.10

# Immich API key with at least asset.upload.
IMMICH_API_KEY=

# Optional overrides (uncomment only if needed):
# GHCR_OWNER=Hanevsky
# IMAGE_TAG=latest
# IMMICH_HOST=http://immich-server:2283
# IMMICH_DOCKER_NETWORK=immich_default
# IMMICH_ALLOW_HTTP=true
# TZ=Europe/Minsk
